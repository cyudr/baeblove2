# Gemini API keys (read server-side only):
# VITE_GEMINI_KEY_FREE is always used first for all Gemini requests.
# VITE_GEMINI_KEY (or GEMINI_API_KEY) is used automatically only when VITE_GEMINI_KEY_FREE reaches its rate/quota limit.
VITE_GEMINI_KEY_FREE="MY_FREE_GEMINI_API_KEY"
VITE_GEMINI_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# baepass_Key: Toggle to enable (1) or disable (0) password protection for the site.
# 1 = password required before entering site
# 0 = password disabled (default)
baepass_Key="0"

# Site access password(s). Any environment variable starting with "bae_Key" is recognized as a valid access password.
# Multiple passwords can be provided (e.g. for different family members or roles).
bae_Key="baelove2026"
bae_Key_Admin="baeloveAdmin2026"

# Supabase Postgres configuration
# Required for persisting app entries and live realtime subscriptions via @supabase/supabase-js
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUB_KEY="your-supabase-publishable-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

